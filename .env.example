# Database
SUDS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/suds
SUDS_DB_ECHO=false

# API auth
SUDS_API_KEYS=changeme

# Caching
SUDS_OSM_CACHE_TTL_DAYS=30
SUDS_WEATHER_CACHE_TTL_DAYS=90

# Overpass/OpenMeteo
SUDS_OVERPASS_URL=https://overpass-api.de/api/interpreter
SUDS_OVERPASS_TIMEOUT_S=60
SUDS_OVERPASS_RATE_LIMIT_DELAY_S=2.0
SUDS_OPENMETEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
SUDS_HTTP_TIMEOUT_S=30

SUDS_OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
SUDS_WEATHER_FORECAST_CACHE_TTL_HOURS=6

SUDS_CITYLAB_BASE_URL=https://citylab.gate-ai.eu/citylab/api
SUDS_CITYLAB_API_KEY=REDACTED
SUDS_CITYLAB_TIMEOUT_S=30

# Optional Gate (currently blocked)
GATE_API_USERNAME=
GATE_API_PASSWORD=
GATE_API_KEY=
GATE_API_KEY_HEADER=X-API-Key